    {{#if calc.formulaire}}
    <h3 class="titre-section">Options communes</h3>

    <div class="form-group beneficiaires">
      <h4>bénéficiaires</h4>
      <div class="liste-beneficiaires">
        {{#each beneficiaires as |b|}}
        <div class="ligne-beneficiaire">
          <input class="beneficiaire" list="noc-liste-pj" data-index="{{b.index}}" type="text" value="{{b.nom}}" placeholder="Bénéficiaire {{b.numero}} (liste ou nom libre)" {{#unless @root.editable}}disabled{{/unless}}>
          {{#if b.supprimable}}{{#if @root.editable}}<a class="retirer-beneficiaire fas fa-trash" data-index="{{b.index}}" title="Retirer ce bénéficiaire"></a>{{/if}}{{/if}}
        </div>
        {{/each}}
        <datalist id="noc-liste-pj">{{#each pjs as |n|}}<option value="{{n}}"></option>{{/each}}</datalist>
        {{#if editable}}<a class="ajouter-beneficiaire"><i class="fas fa-plus"></i> Ajouter un bénéficiaire (+1 niveau)</a>{{/if}}
      </div>
    </div>

    <div class="form-group">
      <h4>durée (cycles)</h4>
      {{#if calc.permanent}}
      <span class="duree-permanente">permanente</span>
      {{else}}
      <span class="compteur-niveau">{{calc.duree}}
        {{#if editable}}
        <span class="compteur-controls">
          <a class="fas fa-add compteur-plus" data-champ="system.duree" data-min="1"></a>
          <a class="fas fa-minus compteur-moins" data-champ="system.duree" data-min="1"></a>
        </span>
        {{/if}}
      </span>
      <span class="note-cout">+1 niveau par cycle supplémentaire</span>
      {{/if}}
    </div>
    {{#if permanentPossible}}
    <div class="form-group case">
      <label><input name="system.permanent" type="checkbox" data-dtype="Boolean" {{checked s.permanent}} {{#unless editable}}disabled{{/unless}}>
        Durée permanente (formulaire possédé à la création du personnage)</label>
    </div>
    {{/if}}

    <div class="form-group">
      <h4>rang du héros</h4>
      <span class="compteur-niveau">{{calc.rang}}
        {{#if editable}}
        <span class="compteur-controls">
          <a class="fas fa-add compteur-plus" data-champ="system.rangSup"></a>
          <a class="fas fa-minus compteur-moins" data-champ="system.rangSup"></a>
        </span>
        {{/if}}
      </span>
      <span class="note-cout">{{#if calc.porteur}}Rang {{calc.rangBase}}{{else}}sans porteur : Rang 1{{/if}} ; +2 niveaux par point au-delà</span>
    </div>

    <h3 class="titre-section">{{lookup formulaires calc.type}}</h3>

    {{#ifequal calc.type "port"}}
    <div class="form-group">
      <h4>objet autorisé</h4>
      <input name="system.port.objet" type="text" value="{{s.port.objet}}" placeholder="ex. Revolver P23 Zmije">
    </div>
    <div class="form-group">
      <h4>limité (X)</h4>
      <span class="compteur-niveau">{{calc.limiteX}}
        {{#if editable}}
        <span class="compteur-controls">
          <a class="fas fa-add compteur-plus" data-champ="system.port.bonusX"></a>
          <a class="fas fa-minus compteur-moins" data-champ="system.port.bonusX"></a>
        </span>
        {{/if}}
      </span>
      <span class="note-cout">X = Rang du Héros ; +1 niveau par point en plus</span>
    </div>
    {{/ifequal}}

    {{#ifequal calc.type "acces"}}
    <div class="form-group">
      <h4>zone</h4>
      <select name="system.acces.zone" data-dtype="Number" class="large">
        {{#each zonesAcces as |label rang|}}
        <option value="{{rang}}" {{#ifequal rang @root.choix.zoneAcces}}selected{{/ifequal}}>{{label}} (Rang {{rang}})</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <h4>motif</h4>
      <input name="system.acces.motif" type="text" value="{{s.acces.motif}}">
    </div>
    <div class="form-group case">
      <label><input name="system.acces.nonLimite" type="checkbox" data-dtype="Boolean" {{checked s.acces.nonLimite}}>
        Circulation non limitée à un secteur</label><span class="note-cout">1 niveau</span>
    </div>
    <div class="form-group case">
      <label><input name="system.acces.sansSurveillance" type="checkbox" data-dtype="Boolean" {{checked s.acces.sansSurveillance}}>
        Circulation sans surveillance</label><span class="note-cout">2 niveaux</span>
    </div>
    {{/ifequal}}

    {{#ifequal calc.type "sortie"}}
    <div class="form-group">
      <h4>zone</h4>
      <select name="system.sortie.zone" data-dtype="Number" class="large">
        {{#each zonesSortie as |label rang|}}
        <option value="{{rang}}" {{#ifequal rang @root.choix.zoneSortie}}selected{{/ifequal}}>{{label}} (Rang {{rang}})</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <h4>durée du séjour</h4>
      <select name="system.sortie.duree" class="large">
        {{selectOptions dureesSortie selected=choix.dureeSortie}}
      </select>
    </div>
    <div class="form-group">
      <h4>motif</h4>
      <input name="system.sortie.motif" type="text" value="{{s.sortie.motif}}">
    </div>
    <div class="form-group case">
      <label><input name="system.sortie.exoneration" type="checkbox" data-dtype="Boolean" {{checked s.sortie.exoneration}}>
        Exonération des examens de sortie</label><span class="note-cout">1 niveau</span>
    </div>
    {{/ifequal}}

    {{#ifequal calc.type "requisition"}}
    <div class="form-group">
      <h4>ressource</h4>
      <select name="system.requisition.mode" class="large">
        {{selectOptions modesRequisition selected=choix.modeRequisition}}
      </select>
    </div>
    <div class="form-group">
      <h4>{{#ifequal choix.modeRequisition "expert"}}talent de l'expert{{else}}détail{{/ifequal}}</h4>
      <input name="system.requisition.detail" type="text" value="{{s.requisition.detail}}">
    </div>
    <p class="regle-specifique">
      {{#ifequal choix.modeRequisition "objet"}}Objet acquis légalement, de Valeur {{calc.valeurMax}} au plus. S'il n'est pas rendu, est très endommagé ou fortement diminué à la fin du formulaire : 1 séquelle de Traque par tranche de 2 niveaux de Valeur perdus.{{/ifequal}}
      {{#ifequal choix.modeRequisition "capital"}}Capital emprunté (tickets de rationnement ou monnaie) de valeur {{calc.capital}}. S'il n'est pas rendu à la fin du formulaire : 1 séquelle de Traque par tranche de 2 niveaux de valeur perdus.{{/ifequal}}
      {{#ifequal choix.modeRequisition "expert"}}Un professionnel du Bureau, avec un unique talent au niveau {{calc.niveauExpert}}. S'il est témoin d'événements ou de comportements suspects : 1 séquelle de Traque par bénéficiaire (ou plus, au choix de la Loi).{{/ifequal}}
      {{#ifequal choix.modeRequisition "escorte"}}Escorte de {{calc.gardes}} Garde{{#ifequal calc.gardes 1}}{{else}}s{{/ifequal}} Noir{{#ifequal calc.gardes 1}}{{else}}s{{/ifequal}}. S'ils sont témoins d'événements ou de comportements suspects, ils réagissent : au minimum 1 séquelle de Traque par bénéficiaire.{{/ifequal}}
    </p>
    {{/ifequal}}

    {{#ifequal calc.type "mandat"}}
    <div class="form-group">
      <h4>sujet</h4>
      <input name="system.mandat.sujet" type="text" value="{{s.mandat.sujet}}">
    </div>
    <div class="form-group">
      <h4>secteur</h4>
      <input name="system.mandat.secteur" type="text" value="{{s.mandat.secteur}}">
    </div>
    <div class="form-group">
      <h4>niveau d'autorité</h4>
      <span class="compteur-niveau">{{calc.autorite}}
        {{#if editable}}
        <span class="compteur-controls">
          <a class="fas fa-add compteur-plus" data-champ="system.mandat.bonusAutorite"></a>
          <a class="fas fa-minus compteur-moins" data-champ="system.mandat.bonusAutorite"></a>
        </span>
        {{/if}}
      </span>
      <span class="note-cout">= Rang du Héros ; +2 niveaux par point en plus</span>
    </div>
    <div class="form-group">
      <h4>citoyens visés</h4>
      <span class="compteur-niveau">{{calc.citoyens}}
        {{#if editable}}
        <span class="compteur-controls">
          <a class="fas fa-add compteur-plus" data-champ="system.mandat.bonusCitoyens"></a>
          <a class="fas fa-minus compteur-moins" data-champ="system.mandat.bonusCitoyens"></a>
        </span>
        {{/if}}
      </span>
      <span class="note-cout">+1 niveau par citoyen en plus</span>
    </div>
    <p class="regle-specifique">Interrogatoire : citoyen de Rang {{calc.rangInterrogation}} ou moins. Fouille : citoyen de Rang {{calc.rangFouille}} ou moins.</p>
    {{/ifequal}}

    {{#ifequal calc.type "signalement"}}
    <div class="form-group">
      <h4>citoyen visé</h4>
      <input name="system.signalement.cible" type="text" value="{{s.signalement.cible}}">
    </div>
    <div class="form-group case">
      <label><input name="system.signalement.bonusStatut" type="checkbox" data-dtype="Boolean" {{checked s.signalement.bonusStatut}}>
        +1 au Domaine Statut pour la confrontation</label><span class="note-cout">1 niveau</span>
    </div>
    <div class="form-group case">
      <label><input name="system.signalement.priseRapide" type="checkbox" data-dtype="Boolean" {{checked s.signalement.priseRapide}}>
        Prise d'effet en un quart</label><span class="note-cout">1 niveau</span>
    </div>
    <p class="regle-specifique">Confrontation des Rangs au bout d'{{calc.delai}}. Le gagnant inflige une nuisance par succès de marge ; pour les nuisances qui durent, 1 succès = un quart, 2 = un cycle, 3 = un mois, 4 = définitif.</p>
    <ul class="nuisances">
      {{#each nuisances as |n|}}<li><strong>{{n.nom}}</strong> : {{n.texte}}</li>{{/each}}
    </ul>
    {{/ifequal}}

    <p class="regle-generale">Sans conséquence, un personnage peut demander par aventure autant de formulaires que son Rang ; chaque formulaire en plus lui vaut 1 séquelle de Traque.</p>
    {{/if}}

