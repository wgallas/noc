<div class="nocRoll">
  <div class="chat-message-header flexcol">
    {{#if actorImg}}
      <div class="flexrow"><img
          class="actor-icon"
          src="{{actorImg}}"
          alt="{{alias}}"
        />
        <h4 class="chat-actor-name">{{alias}}</h4>
      </div>
      <div class="flexrow"> {{#if (eq mode "talent")}}
          <h4>Talent : {{talent.label}} ({{talent.niveau}})</h4>
        {{/if}}
        {{#if (eq mode "arme")}}
          <h4>Arme : {{arme.name}} </h4>
        {{/if}}
    {{/if}}
  </div>


  <hr>

  {{#if img}}
    <div class="chat-message-header flex flexcol">
      <div class="flexrow"> <img
          class="chat-icon"
          src="{{img}}"
          alt="{{name}}"
        />
        <h4 class="chat-actor-name">{{name}}</h4>
      </div>
      <div class="flexrow"> {{#if (eq mode "talent")}}
          <h4>Talent : {{talent.label}} ({{talent.niveau}})</h4>
        {{/if}}
        {{#if (eq mode "arme")}}
          <h4>Arme : {{arme.name}} </h4>
        {{/if}}
      </div>

    </div>
  {{/if}}

  <div>
    <ul>


      <li>Dés de domaine utilisés : {{nbDesDomaine}}</li>
      {{#if nbDesCabale}}
        <li>Dés de cabale utilisés : {{nbDesCabale}} ({{cabaleData.name}})</li>
      {{/if}}
      <li class="dicesResults flexrow">
        {{#each roll.terms as |term index|}}
          {{#each term.results as |dice index|}}
            <div class="dice
            {{#if dice.success}} success {{/if}}
            {{#ifequal dice.result 1}} fiel{{/ifequal}}
            {{#ifequal dice.result 10}} relance{{/ifequal}}
            ">
              {{dice.result}}
              <i class="fa-light fa-dice-d10"></i>
            </div>
          {{/each}}
        {{/each}}

        {{#each rollBonus.terms as |term index|}}
          {{#each term.results as |dice index|}}
            <div class="dice relance
            {{#if dice.success}} success {{/if}}
            {{#ifequal dice.result 1}} fiel{{/ifequal}}
            {{#ifequal dice.result 10}} relance{{/ifequal}}
            ">
              {{dice.result}}
              <i class="fa-light fa-dice-d10"></i>

            </div>
          {{/each}}
        {{/each}}
      </li>
      {{#if nbBonusCollaboratif}}
        <li>Bonus collaboratif : {{nbBonusCollaboratif}}</li>
      {{/if}}
      {{#if fluxActif}}
        <li>Près d'un Seuil (Flux {{flux}}){{#if fluxImpose}} : {{fluxImpose}} dé{{#ifgt fluxImpose 1}}s{{/ifgt}} de destin ajouté{{#ifgt fluxImpose 1}}s{{/ifgt}} pour atteindre le minimum{{/if}}</li>
      {{/if}}
      {{#if bonusEquipement}}
        <li>Équipement (stratagèmes) : +{{bonusEquipement}}</li>
      {{/if}}
      {{#if useEspoir}}
        <li>Un point d'Espoir a été utilisé</li>
      {{/if}}
      {{#if useVecu}}
        <li>Un point de Vécu a été utilisé</li>
      {{/if}}
      {{#if bonusCabale}}
        <li>Cabale {{cabaleData.name}} (Atouts) : {{bonusCabaleTexte}}</li>
      {{/if}}
      {{#if useEspoirCabale}}
        <li>Un point d'Espoir de la cabale a été utilisé</li>
      {{/if}}
      {{#if useVecuCabale}}
        <li>Un point de Vécu de la cabale a été utilisé</li>
      {{/if}}
      {{#if rouageHostile}}{{#if nbFiel}}<li>Rouage hostile, dés à 1 : {{nbFiel}} (le Fiel baisse d'autant)</li>{{/if}}{{else}}<li>Gouttes de Fiel ajoutées : {{nbFiel}}</li>{{/if}}
      {{#unless rouageHostile}}{{#if nbFielTotal}}<li><a class="singularite-fiel" data-max="{{nbFielTotal}}" data-tooltip="Un Héros dépense 1 point de Singularité pour empêcher l'ajout d'une goutte de Fiel (une fois par 1 obtenu)"><i class="fa-solid fa-atom"></i> Annuler une goutte (1 Singularité)</a></li>{{/if}}{{/unless}}
      <li style="font-weight: bold; color: var(--color-text);">Nombre de succès : {{nbSuccess}}</li>
      <li class="rollResult">Niveau final obtenu : <strong>{{niveauFinal}}</strong></li>

      {{#unless (eq mode "arme")}}
      {{#if aNiveauRequis}}
        {{#if isReussite}}
          <li class="rollResult reussite">Réussite !! (Marge {{margin}})</li>
        {{else}}
          <li class="rollResult echec">Echec!! (Marge {{margin}})</li>
        {{/if}}
      {{/if}}
      {{/unless}}
    </ul>

    {{#if soin}}
      <div class="bloc-soin">
        <p>{{soin.label}} : jusqu'à <strong>{{soin.niveau}}</strong> point{{#ifequal soin.niveau 1}}{{else}}s{{/ifequal}} retiré{{#ifequal soin.niveau 1}}{{else}}s{{/ifequal}}</p>
        {{#each soin.cibles as |c|}}
          <a class="appliquer-soin bouton-soin" data-uuid="{{c.actorUuid}}"><i class="fa-solid fa-hand-holding-medical"></i> {{c.nom}}</a>
        {{/each}}
        <a class="appliquer-soin bouton-soin" data-uuid=""><i class="fa-solid fa-crosshairs"></i> Cible actuelle</a>
      </div>
    {{/if}}

    {{#if (eq mode "arme")}}
    {{#if aNiveauRequis}}
      <div class="resultat-combat">
        <hr>
        {{#if isReussite}}
          <p class="verdict-combat reussite">Réussite</p>
        {{else}}
          <p class="verdict-combat echec">Échec</p>
        {{/if}}
        <p class="marge-combat {{#if isReussite}}reussite{{else}}echec{{/if}}">{{#if isReussite}}Marge de succès : {{margin}}{{else}}Marge d'échec : {{margin}}{{/if}}</p>

        {{#if isReussite}}
          {{#if choixMarge}}
            <div class="repartition-marge">
              <span class="marge-part" data-tooltip="+1 point de Blessures par niveau, sur la 1re touche">Précision <strong>{{precision}}</strong></span>
              <a class="marge-etendue" data-ecart="-1" data-tooltip="1 point de marge en Précision"><i class="fa-solid fa-arrow-left"></i></a>
              <a class="marge-etendue" data-ecart="1" data-tooltip="1 point de marge en Étendue"><i class="fa-solid fa-arrow-right"></i></a>
              <span class="marge-part" data-tooltip="+1 à la valeur X du trait Multiple par niveau">Étendue <strong>{{etendue}}</strong> → Multiple ({{multipleTotal}})</span>
            </div>
          {{else}}{{#if margin}}
            <p class="note-combat">Précision : +{{margin}} point{{#ifgt margin 1}}s{{/ifgt}} de Blessures (marge)</p>
          {{/if}}{{/if}}
          {{#if quantique}}
            <p class="titre-bloc-combat">Effet quantique ({{quantique.nbDes}} dé{{#ifequal quantique.nbDes 1}}{{else}}s{{/ifequal}}) : +{{quantique.succes}}</p>
            <div class="dicesResults flexrow">
              {{#each quantique.des as |dice|}}
                <div class="dice{{#if dice.success}} success{{/if}}{{#ifequal dice.result 1}} fiel{{/ifequal}}{{#ifequal dice.result 10}} relance{{/ifequal}}">
                  {{dice.result}} <i class="fa-light fa-dice-d10"></i>
                </div>
              {{/each}}
            </div>
            {{#if quantique.fiel}}<p class="note-combat">{{#if rouageHostile}}Dés quantiques à 1 (Rouage hostile) : {{quantique.fiel}}{{else}}Gouttes de Fiel ajoutées : {{quantique.fiel}}{{/if}}</p>{{/if}}
          {{/if}}
          {{#if energieNoire}}
            <p class="titre-bloc-combat">Énergie noire : +{{energieNoire}}</p>
          {{/if}}

          {{#if traitsCombat.length}}
            <hr>
            <ul class="traits-combat">
              {{#each traitsCombat as |t|}}
                <li><strong>{{t.nom}}</strong> : {{t.texte}}</li>
              {{/each}}
            </ul>
          {{/if}}
        {{/if}}
      </div>
    {{/if}}
    {{/if}}

    {{#if nbAddDice}}
      <section>
        <p>Vous pouvez bénéficier de {{nbAddDice}} dés. Combien voulez vous en lancer ?</p>
        <ul class="flexrow dice-bonus-buttons">
          <button
            class="roll-dice-bonus"
            data-nb-dice="0"
          >Aucun dé</button>
          {{#repeat nbAddDice}}
            <button
              class="roll-dice-bonus"
              data-nb-dice="{{add @index 1}}"
            >{{add @index 1}} Dé(s)</button>
          {{/repeat}}
        </ul>

      </section>
    {{/if}}

  </div>
</div>