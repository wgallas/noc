<div class="panneau-mj-contenu">

  <nav class="onglets-mj flexrow">
    <a class="onglet-lien {{#if (eq onglet "individus")}}actif{{/if}}" data-onglet="individus"><i class="fa-solid fa-users"></i> Individus et perditions</a>
    <a class="onglet-lien {{#if (eq onglet "fiel")}}actif{{/if}}" data-onglet="fiel"><i class="fa-solid fa-droplet"></i> Menace et effets de Fiel</a>
    <a class="onglet-lien {{#if (eq onglet "temps")}}actif{{/if}}" data-onglet="temps"><i class="fa-solid fa-hourglass-half"></i> Temps et progression</a>
    <a class="onglet-lien {{#if (eq onglet "bureau")}}actif{{/if}}" data-onglet="bureau"><i class="fa-solid fa-stamp"></i> Bureau</a>
  </nav>

  <div class="onglet-mj {{#if (eq onglet "individus")}}actif{{/if}}" data-onglet="individus">
  <!-- CIBLES -->
  <section class="bloc">
    <h3 class="flexrow">
      <span>Personnages</span>
      <a data-action="toutCocher" data-tous="1" data-groupe="personnages" data-tooltip="tout cocher"><i class="fa-solid fa-square-check"></i></a>
      <a data-action="toutCocher" data-tous="0" data-groupe="personnages" data-tooltip="tout décocher"><i class="fa-regular fa-square"></i></a>
    </h3>
    <div class="liste-cibles">
      {{#each personnages as |p|}}
      {{> ligneCibleMJ p}}
      {{else}}
      <p>Aucun personnage actif.</p>
      {{/each}}
    </div>
    {{#if endormis.length}}
    <details class="sommeil" {{#if sommeilOuvert}}open{{/if}}>
      <summary>En sommeil ({{endormis.length}})</summary>
      <div class="liste-sommeil">
        {{#each endormis as |p|}}
        <div class="ligne-sommeil flexrow">
          <img src="{{p.img}}" alt="">
          <span class="nom">{{p.nom}}</span>
          <span class="raison">{{p.raison}}</span>
          <a data-action="reveiller" data-uuid="{{p.uuid}}" data-tooltip="Réactiver"><i class="fa-solid fa-sun"></i></a>
        </div>
        {{/each}}
      </div>
    </details>
    {{/if}}
    <h3 class="flexrow">
      <span>Sur la scène (PNJ, rouages, créatures, Autres)</span>
      <a data-action="toutCocher" data-tous="1" data-groupe="adversaires" data-tooltip="tout cocher"><i class="fa-solid fa-square-check"></i></a>
      <a data-action="toutCocher" data-tous="0" data-groupe="adversaires" data-tooltip="tout décocher"><i class="fa-regular fa-square"></i></a>
    </h3>
    <div class="liste-cibles">
      {{#each adversaires as |p|}}
      {{> ligneCibleMJ p}}
      {{else}}
      <p>Aucun jeton de PNJ sur la scène affichée.</p>
      {{/each}}
    </div>
  </section>

  <!-- PERDITIONS -->
  <section class="bloc">
    <h3>Perditions</h3>
    <label class="option">
      <input type="checkbox" class="reductions" {{#if reductions}}checked{{/if}}>
      Appliquer les réductions (Trauma − Folie, Noirceur − Lumière, Traque − Façade)
    </label>
    <div class="grille-perditions">
      {{#each perditions as |p|}}
      <div class="perdition-ligne">
        <span class="libelle">{{p.label}}{{#if p.reduction}} <em>(− {{p.reduction}})</em>{{/if}}</span>
        <span class="points-ligne">
          <a data-action="points" data-perdition="{{p.cle}}" data-delta="-1" data-tooltip="−1"><i class="fa-solid fa-minus"></i></a>
          <strong class="points">{{p.points}}</strong>
          <a data-action="points" data-perdition="{{p.cle}}" data-delta="1" data-tooltip="+1"><i class="fa-solid fa-plus"></i></a>
        </span>
        <button type="button" data-action="infliger" data-perdition="{{p.cle}}">Infliger</button>
        <button type="button" data-action="soigner" data-perdition="{{p.cle}}">Soigner</button>
      </div>
      {{/each}}
    </div>
  </section>

  </div>

  <div class="onglet-mj {{#if (eq onglet "fiel")}}actif{{/if}}" data-onglet="fiel">
  <!-- FIEL ET MENACE -->
  <section class="bloc">
    <h3>Fiel et Menace</h3>
    <div class="ligne-fiel flexrow">
      <span>Gouttes : <strong>{{fiel.gouttes}}</strong> / 35</span>
      <span>Menace : <strong>{{fiel.menace}}</strong></span>
      <button type="button" data-action="fiel" data-delta="-5">−5</button>
      <button type="button" data-action="fiel" data-delta="-1">−1</button>
      <button type="button" data-action="fiel" data-delta="1">+1</button>
      <button type="button" data-action="fiel" data-delta="5">+5</button>
    </div>
    <p class="aide">Moment de calme, début de séance et début de scénario : onglet « Temps et progression ».</p>
  </section>

  <!-- FLUX D'UN SEUIL -->
  <section class="bloc flux-seuil">
    <h3 class="flexrow">
      <span data-tooltip="Livre de base p. 205 : près d'un Seuil, qui provoque le destin lance au moins Flux dés de destin, et peut lancer jusqu'à Domaine + Flux dés de domaine.">Effet d'environnement : Flux d'un Seuil</span>
      <span class="valeur-flux {{#if flux.valeur}}actif{{/if}}">Flux : <strong>{{flux.valeur}}</strong></span>
    </h3>
    <div class="reglages-flux flexrow">
      <select class="reglage-flux" data-cle="lieu" data-tooltip="Lieu (Flux de base)">
        {{#each flux.lieux as |l|}}<option value="{{l.cle}}" {{#if l.choisi}}selected{{/if}}>{{l.label}}</option>{{/each}}
      </select>
      <select class="reglage-flux" data-cle="tarissement" data-tooltip="Temps écoulé depuis la dernière ouverture du Seuil" {{#if flux.inactif}}disabled{{/if}}>
        {{#each flux.tarissements as |t|}}<option value="{{t.cle}}" {{#if t.choisi}}selected{{/if}}>{{t.label}}</option>{{/each}}
      </select>
      <select class="reglage-flux" data-cle="eloignement" data-tooltip="Le Flux baisse de 1 tous les 10 m depuis les limites du Seuil (sauf à travers métaux lourds, basalte, béton armé, Matière noire)" {{#if flux.inactif}}disabled{{/if}}>
        {{#each flux.eloignements as |e|}}<option value="{{e.cle}}" {{#if e.choisi}}selected{{/if}}>{{e.label}}</option>{{/each}}
      </select>
    </div>
    <div class="flexrow boutons-flux">
      <button type="button" data-action="annoncerFlux" data-tooltip="Message public aux joueurs">Annoncer aux joueurs</button>
      <button type="button" data-action="sansFlux" {{#if flux.inactif}}disabled{{/if}}>Quitter le Seuil</button>
    </div>
    <p class="aide">Tant que le Flux est supérieur à 0, la fenêtre de jet propose la case « Près du Seuil » (cochée par défaut, à décocher pour un personnage éloigné). Le Flux s'ajoute aussi à la classe exogène des Autres pour leur flétrissement.</p>
  </section>

  <!-- EFFETS DE FIEL -->
  <section class="bloc">
    <h3 class="flexrow">
      <span>Effets de Fiel par niveau de Menace</span>
      <a data-action="bibliotheque" data-tooltip="ouvrir la bibliothèque des effets"><i class="fa-solid fa-book"></i> Bibliothèque</a>
    </h3>
    <label class="option">
      Tirage au sort parmi :
      <select class="categorie-tirage">
        <option value="" {{#unless categorie}}selected{{/unless}}>toutes les catégories</option>
        {{#each categories as |c|}}<option value="{{c}}" {{#if (eq c @root.categorie)}}selected{{/if}}>{{c}}</option>{{/each}}
      </select>
    </label>
    <div class="niveaux-menace">
      {{#each niveaux as |n|}}
      <div class="niveau-ligne {{#unless n.atteint}}non-atteint{{/unless}} {{#if n.actif}}avec-effet{{/if}}">
        <span class="niveau" data-tooltip="{{#if n.atteint}}niveau de Menace atteint{{else}}niveau de Menace non atteint{{/if}}">{{n.niveau}}</span>
        {{#if n.actif}}
          <span class="effet-actif" data-tooltip="{{n.actif.description}}">{{n.actif.nom}}</span>
          <button type="button" data-action="arreterEffet" data-niveau="{{n.niveau}}">Arrêter</button>
        {{else}}
          <select class="choix-effet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}}>
            <option value="">— choisir un effet —</option>
            {{#each n.groupes as |g|}}
            <optgroup label="{{g.categorie}}">
              {{#each g.effets as |e|}}<option value="{{e.id}}" {{#if e.selectionne}}selected{{/if}}>{{e.nom}}</option>{{/each}}
            </optgroup>
            {{/each}}
          </select>
          <button type="button" data-action="tirerEffet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}} data-tooltip="tirer un effet au hasard"><i class="fa-solid fa-dice"></i></button>
          <button type="button" data-action="appliquerEffet" data-niveau="{{n.niveau}}" {{#unless n.atteint}}disabled{{/unless}}>Appliquer</button>
        {{/if}}
      </div>
      {{/each}}
    </div>
    <p class="aide">Un effet s'arrête automatiquement quand la Menace redescend sous son niveau. Les effets immédiats touchent les personnages cochés ; les malus de talents s'appliquent tant que l'effet est actif.</p>
    <div class="lever-etats flexrow">
      <button type="button" data-action="leverEtat" data-etat="fatigue">Lever la fatigue</button>
      <button type="button" data-action="leverEtat" data-etat="bouleversement">Lever l'ancien bouleversement</button>
    </div>
  </section>
  </div>
  <div class="onglet-mj {{#if (eq onglet "temps")}}actif{{/if}}" data-onglet="temps">
  <!-- HORLOGE DU BLOC -->
  <section class="bloc horloge-bloc">
    <h3>Horloge du Bloc</h3>
    <div class="horloge-date flexrow">
      <span class="horloge-texte"><i class="fa-solid fa-clock"></i> {{horloge.texte}}</span>
      <span class="horloge-cycle" data-tooltip="cycle du Bureau (validité des documents)">cycle {{horloge.cycleBureau}} du Bureau</span>
    </div>
    <div class="horloge-boutons flexrow">
      <button type="button" data-action="avancer" data-quarts="1">+1 quart</button>
      <button type="button" data-action="avancer" data-quarts="{{quarts.cycle}}">+1 cycle</button>
      <button type="button" data-action="avancer" data-quarts="{{quarts.mois}}">+1 mois</button>
      <button type="button" data-action="avancerLibre"><i class="fa-solid fa-forward"></i> Avancer…</button>
    </div>
    <p class="aide">1 cycle = 7 quarts de 7 heures ; 1 mois = 14 cycles. Chaque cycle : documents du Bureau ; chaque mois : +1 point de progression par Héros, Régression tous les 6 mois vécus, intermède des cabales.</p>
  </section>

  <!-- RYTHME DE JEU -->
  <section class="bloc rythme-jeu">
    <h3>Rythme de jeu</h3>
    <div class="rythme-boutons">
      <button type="button" data-action="calme" data-tooltip="Fiel −1, récupération des Héros, horloge +1 quart (par défaut)"><i class="fa-solid fa-mug-hot"></i> Moment de calme…</button>
      <button type="button" data-action="seance" data-tooltip="Menace −1 (Fiel −5), Singularité au maximum, Vécu +1"><i class="fa-solid fa-dice"></i> Début de séance</button>
      <button type="button" data-action="scenario" data-tooltip="Fiel à 0, Espoir au maximum, faveurs rendues, cabales rechargées, excès levés ; clôt le Passage"><i class="fa-solid fa-book-open"></i> Début de scénario</button>
      <button type="button" data-action="finScenario" data-tooltip="Points de progression des Héros, intermède, ouverture du Passage"><i class="fa-solid fa-flag-checkered"></i> Fin de scénario…</button>
    </div>
  </section>

  <!-- PROGRESSION -->
  <section class="bloc progression-mj">
    <h3 class="flexrow">
      <span>Progression des Héros</span>
      {{#if passage}}<span class="passage-etat ouvert">Passage ouvert</span><button type="button" data-action="clorePassage" data-tooltip="Chaque Héros garde au plus 2 points">Clore le passage</button>{{else}}<span class="passage-etat">Pas de Passage en cours</span>{{/if}}
    </h3>
    <table class="table-progression">
      <tr><th></th><th>Héros</th><th>Points</th><th>Mois vécus</th><th>Régressions</th><th></th></tr>
      {{#each herosTemps as |h|}}
      <tr class="{{#if h.sommeil}}sommeil{{/if}}">
        <td><img src="{{h.img}}" alt=""></td>
        <td>{{h.nom}}{{#if h.sommeil}} <small>(en réserve)</small>{{/if}}</td>
        <td class="nombre {{#if h.peutDepenser}}{{#if @root.passage}}a-depenser{{/if}}{{/if}}">{{h.progression}}</td>
        <td class="nombre">{{h.mois}}</td>
        <td class="nombre {{#if h.regressions}}alerte{{/if}}">{{h.regressions}}</td>
        <td><a data-action="historique" data-id="{{h.id}}" data-tooltip="historique de progression"><i class="fa-solid fa-scroll"></i></a></td>
      </tr>
      {{/each}}
    </table>
  </section>
  </div>
  <div class="onglet-mj {{#if (eq onglet "bureau")}}actif{{/if}}" data-onglet="bureau">
  <section class="bloc">
    <h3 class="flexrow">
      <span>Registre du Bureau — cycle {{cycle}}</span>
      <button type="button" data-action="nouveauCycle" data-tooltip="Passer au cycle suivant : les documents vieillissent d'un cycle"><i class="fa-solid fa-calendar-plus"></i> Nouveau cycle</button>
    </h3>
    {{#if registre.length}}
    <table class="registre-bureau">
      <tr><th>Document</th><th>Titulaire</th><th>Bénéficiaires</th><th>Validité</th></tr>
      {{#each registre as |d|}}
      <tr class="{{#if d.perime}}perime{{/if}}">
        <td><a data-action="ouvrirDocument" data-uuid="{{d.uuid}}">{{d.nom}}</a><br><small>{{d.type}} · {{d.numero}}</small></td>
        <td>{{d.titulaire}}</td>
        <td><small>{{d.beneficiaires}}</small></td>
        <td>{{#if d.permanent}}permanent{{else}}{{#if d.perime}}périmé{{else}}{{d.restants}} cycle(s){{/if}}{{/if}}</td>
      </tr>
      {{/each}}
    </table>
    {{else}}
    <p class="aide">Aucun document délivré. Les Héros en demandent depuis leur fiche (inventaire, « Demander un formulaire »).</p>
    {{/if}}
  </section>
  </div>
</div>
